mixin icon(name)
  case name
    when 'chevron'
      svg.nav__chev(
        width='6',
        height='11',
        viewBox='0 0 6 11',
        fill='none',
        stroke='currentColor',
        stroke-width='1.5',
        aria-hidden='true'
      )&attributes(attributes)
        path(d='M.5.5l5 5-5 5')
    when 'mail'
      svg(
        width='14',
        height='10',
        viewBox='0 0 14 10',
        fill='none',
        stroke='currentColor',
        stroke-width='1.3',
        aria-hidden='true'
      )&attributes(attributes)
        rect(x='.65', y='.65', width='12.7', height='8.7')
        path(d='M1 1l6 5 6-5')
    when 'heart'
      svg(
        width='13',
        height='11.7',
        viewBox='0 0 34 30.6',
        fill='currentColor',
        aria-hidden='true'
      )&attributes(attributes)
        path(d='M17 30C4 20 0 12 4 6C8 0 15 1 17 7C19 1 26 0 30 6C34 12 30 20 17 30Z')
    when 'plus'
      svg(
        width='18',
        height='18',
        viewBox='0 0 18 18',
        fill='none',
        stroke='currentColor',
        stroke-width='2',
        aria-hidden='true'
      )&attributes(attributes)
        path(d='M9 1v16M1 9h16')
    when 'arrow-right'
      svg(
        width='5',
        height='9',
        viewBox='0 0 5 9',
        fill='none',
        stroke='currentColor',
        stroke-width='1.2',
        aria-hidden='true'
      )&attributes(attributes)
        path(d='M.5.5l4 4-4 4')
    when 'arrow-up'
      svg(
        width='12',
        height='14',
        viewBox='0 0 12 14',
        fill='none',
        stroke='currentColor',
        stroke-width='2',
        aria-hidden='true'
      )&attributes(attributes)
        path(d='M6 14V2M1 6l5-5 5 5')
    when 'check'
      svg.success__icon(width='24', height='24', viewBox='0 0 24 24', aria-hidden='true')&attributes(attributes)
        circle(cx='12', cy='12', r='12')
        path.success__check(d='M7 12l3.5 3.5L17 9', fill='none', stroke-width='2')
    when 'web'
      svg(width='42', height='30', viewBox='0 0 42 30', aria-hidden='true')&attributes(attributes)
        rect.fill-ice.stroke-slate(x='2', y='2', width='38', height='26', stroke-width='4')
        rect.fill-green(x='8', y='8', width='14', height='10')
    when 'motion'
      svg(width='40', height='32', viewBox='0 0 40 32', aria-hidden='true')&attributes(attributes)
        rect.fill-slate(width='40', height='32', rx='6')
        rect.fill-sky(x='7', y='6', width='26', height='20', rx='3')
    when 'print'
      svg(width='42', height='34', viewBox='0 0 42 34', aria-hidden='true')&attributes(attributes)
        rect.fill-yellow(x='10', width='22', height='20')
        rect.fill-gray(y='16', width='42', height='18', rx='3')
    when 'illustration'
      svg(width='34', height='30.6', viewBox='0 0 34 30.6', aria-hidden='true')&attributes(attributes)
        path.fill-accent(d='M17 30C4 20 0 12 4 6C8 0 15 1 17 7C19 1 26 0 30 6C34 12 30 20 17 30Z')
