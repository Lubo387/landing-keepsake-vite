mixin picture(options)
  - const { name, alt = '', width = 800, height = 632, className = '', lazy = true, sizes = '(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw', widths = [400, 800] } = options;
  - const base = '/landing-keepsake-vite/assets/images/';
  - const w1 = widths[0];
  - const w2 = widths[1];
  picture
    source(
      type='image/avif',
      srcset=`${base}${name}-${w1}.avif ${w1}w, ${base}${name}-${w2}.avif ${w2}w`,
      sizes=sizes
    )
    source(
      type='image/webp',
      srcset=`${base}${name}-${w1}.webp ${w1}w, ${base}${name}-${w2}.webp ${w2}w`,
      sizes=sizes
    )
    if lazy
      img(
        class=className,
        src=`${base}${name}-${w2}.jpg`,
        alt=alt,
        width=width,
        height=height,
        loading='lazy',
        decoding='async'
      )&attributes(attributes)
    else
      img(
        class=className,
        src=`${base}${name}-${w2}.jpg`,
        alt=alt,
        width=width,
        height=height,
        fetchpriority='high',
        decoding='async'
      )&attributes(attributes)
